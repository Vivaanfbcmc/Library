<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_library_book" model="ir.actions.report">
        <field name="name">Book List Report</field>
        <field name="model">library.book</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_management.report_library_book_list</field>
        <field name="report_file">library_management.report_library_book_list</field>
        <field name="print_report_name">'Book List Report'</field>
        <field name="binding_model_id" ref="model_library_book"/>
    </record>

    <template id="report_library_book_list" name="library_management.report_library_book_list">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Library Book List</h2>
                    <table class="table table-bordered table-striped">
                        <thead style="background-color:#f0f0f0;">
                            <tr>
                                <th class="text-center">Title</th>
                                <th class="text-center">Author</th>
                                <th class="text-center">Price</th> 
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="docs" t-as="book">
                                <tr>
                                    <td class="text-center"><t t-esc="book.title"/></td>
                                    <td class="text-center"><t t-esc="book.author_id"/></td>
                                    <td class="text-center"><t t-esc="book.price"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
