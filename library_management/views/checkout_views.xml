<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="library_checkout_view_list" model="ir.ui.view">
        <field name="name">library.checkout.view.tree</field>
        <field name="model">library.checkout</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="checkout_date"/>
                <field name="issued_by"/>
            </list>
        </field>
    </record>
    <record id="library_checkout_view_form" model="ir.ui.view">
        <field name="name">library.checkout.view.form</field>
        <field name="model">library.checkout</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="checkout_date"/>
                        <field name="issued_by"/>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="line_ids">
                                <list>
                                    <field name="book_id"/>
                                    <field name="issue_date"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="library_checkout_action" model="ir.actions.act_window">
        <field name="name">Checkouts</field>
        <field name="res_model">library.checkout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>