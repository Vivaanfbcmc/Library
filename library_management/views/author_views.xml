<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="library_author_view_list" model="ir.ui.view">
        <field name="name">library_author.view.tree</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="issued_count"/>
            </list>
        </field>
    </record>

    <record id="library_author_view_form" model="ir.ui.view">
        <field name="name">library_author.view.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_issue_book" icon="fa-book">
                            <field name="issued_count" widget="statinfo" string="Times Issued"/>
                        </button>
                    </div>

                    <field name="image" widget="image" class="oe_avatar"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Author Name"/></h1>
                    </div>

                    <group>
                        <field name="bio"/>
                    </group>

                    <notebook>
                        <page string="Books">
                            <field name="book_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="isbn"/>
                                    <field name="price"/>
                                    <field name="book_age"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_author_action" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>