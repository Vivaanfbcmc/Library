<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="library_return_view_tree" model="ir.ui.view">
        <field name="name">library.return.view.tree</field>
        <field name="model">library.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="book_id"/>
                <field name="partner_id"/>
                <field name="issue_id"/>
                <field name="return_date"/>
            </list>
        </field>
    </record>

    <record id="library_return_view_form" model="ir.ui.view">
        <field name="name">library.return.view.form</field>
        <field name="model">library.return</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="book_id"/>
                        <field name="partner_id"/>
                        <field name="issue_id"/>
                        <field name="return_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_return_action" model="ir.actions.act_window">
        <field name="name">Library Return</field>
        <field name="res_model">library.return</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>