<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="portal_my_library" name="My Library">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <h3>My Library</h3>

            <h5>Currently Issued Books</h5>
            <table class="table" t-if="issues">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="issues" t-as="issue">
                        <td><t t-esc="issue.book_id.title"/></td>
                        <td><t t-esc="issue.issue_date"/></td>
                        <td><t t-esc="issue.due_date"/></td>
                        <td><t t-esc="issue.state"/></td>
                    </tr>
                </tbody>
            </table>
            <p t-else="">No issued books.</p>

            <h5>Return History</h5>
            <table class="table" t-if="returns">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Return Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="returns" t-as="ret">
                        <td><t t-esc="ret.book_id.title"/></td>
                        <td><t t-esc="ret.return_date"/></td>
                    </tr>
                </tbody>
            </table>
            <p t-else="">No return history.</p>

            <h5>Outstanding Fines</h5>
            <table class="table" t-if="fines">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="fines" t-as="fine">
                        <td><t t-esc="fine.name"/></td>
                        <td><t t-esc="fine.amount_total"/></td>
                        <td><t t-esc="fine.payment_state"/></td>
                    </tr>
                </tbody>
            </table>
            <p t-else="">No outstanding fines.</p>

            <h5>Reservation Queue</h5>
            <table class="table" t-if="reservations">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Queue Position</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="reservations" t-as="res">
                        <td><t t-esc="res.book_id.title"/></td>
                        <td><t t-esc="res.sequence"/></td>
                        <td><t t-esc="res.state"/></td>
                    </tr>
                </tbody>
            </table>
            <p t-else="">No active reservations.</p>

            <h5>Membership Status</h5>
            <p t-if="membership">
                Status: <t t-esc="membership.state"/><br/>
                Valid until: <t t-esc="membership.end_date"/>
            </p>
            <p t-else="">No membership on record.</p>

        </t>
    </template>

    <template id="portal_my_home_library" name="Library Card on Portal Home" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_index_card col-md-6 order-2">
                <a href="/my/library" title="My Library" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                            <span>My Library</span>
                        </div>
                        <div class="opacity-75">
                            View issued books, return history, fines and reservations
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

</odoo> 