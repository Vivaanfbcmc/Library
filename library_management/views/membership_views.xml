<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="library_membership_view_list" model="ir.ui.view">
        <field name="name">library.membership.view.tree</field>
        <field name="model">library.membership</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="duration_months"/>
                <field name="end_date"/>
                <field name="next_invoice_date"/>
                <field name="monthly_fee"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="library_membership_view_form" model="ir.ui.view">
        <field name="name">library.membership.view.form</field>
        <field name="model">library.membership</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel_membership" type="object" string="Cancel Membership" class="btn-secondary" invisible="state != 'active'"/>
                </header>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="start_date"/>
                        <field name="duration_months"/>
                        <field name="end_date" readonly="1"/>
                        <field name="next_invoice_date"/>
                        <field name="monthly_fee"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="library_membership_action" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">library.membership</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>