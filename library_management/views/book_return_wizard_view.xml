<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="book_return_view_form" model="ir.ui.view">
        <field name="name">book.return.wizard.view.form</field>
        <field name="model">book.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Book">
                <group>
                    <field name="issue_id" domain="[('state','in',['issued','overdue']), ('book_id','=', context.get('default_book_id', False))]"/>
                    <field name="partner_id"/>
                    <field name="book_id"/>
                    <field name="return_date"/>
                </group>
                <footer>
                    <button name="action_return_book" type="object" string="Return Book" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="book_return_wizard_action" model="ir.actions.act_window">
        <field name="name">Return Book</field>
        <field name="res_model">book.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>