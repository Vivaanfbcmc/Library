<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_library_management" model="ir.module.category">
        <field name="name">Library Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_library_management" model="res.groups.privilege">
        <field name="name">Library Management</field>
        <field name="category_id" ref="module_category_library_management"></field>
        <field name="sequence">1</field>
    </record>

    <record id="group_library_user" model="res.groups">
        <field name="name">Library User</field>
        <field name="privilege_id" ref="privilege_library_management"/>
        <field name="sequence">3</field>
    </record>

    <record id="group_library_manager" model="res.groups">
        <field name="name">library Manager</field>
        <field name="privilege_id" ref="privilege_library_management"/>
        <field name="sequence">2</field>
        <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>

    </record>
</odoo>
